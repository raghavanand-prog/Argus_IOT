# Copy to .env and fill in. Never commit the real .env.

# Enforcement is dry-run unless this is explicitly "true". Do not flip this in shared/demo envs.
ARGUS_ENFORCE=false

# Bearer token required for any state-changing API call. No default — startup fails without one.
ARGUS_ADMIN_TOKEN=change-me-local-dev-only

# SQLite by default; point at a Postgres DSN to use Postgres instead.
ARGUS_DATABASE_URL=sqlite:///./argus.db

# Significance level for the conformal prediction gate.
ARGUS_CONFORMAL_ALPHA=0.05
